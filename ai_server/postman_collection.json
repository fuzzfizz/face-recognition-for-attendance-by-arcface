{
  "info": {
    "name": "Face Recognition API v4 (Supabase + Local .pkl)",
    "description": "Hybrid architecture API: face matching via local .pkl (fast), data via Supabase (or SQLite fallback)\n\n## Key Changes in v4\n- **Dual-mode:** Supabase (cloud) OR SQLite (local) — auto-select based on environment variables\n- **Health check** returns current mode (`supabase` or `sqlite`)\n- **Face matching** always uses local .pkl (no network latency)\n- **Image upload** goes to Supabase Storage (cloud) or local disk (SQLite mode)\n- **All endpoints** remain backward compatible",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "face-recognition-api-v4"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://<YOUR-VM-IP>:8000",
      "type": "string"
    },
    {
      "key": "adminKey",
      "value": "your-secret-admin-key",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "6600001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "description": "Check if the server is running and see which mode (supabase/sqlite) is active",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "response": [
        {
          "name": "Success (Supabase mode)",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"status\": \"ok\",\n    \"mode\": \"supabase\"\n}"
        },
        {
          "name": "Success (SQLite mode)",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"status\": \"ok\",\n    \"mode\": \"sqlite\"\n}"
        }
      ]
    },
    {
      "name": "Register (Async Queue)",
      "description": "Upload face images for registration. Non-blocking — saves image to storage (Supabase or local), creates queue entries (status='pending'), and returns immediately.\n\nAI processing happens later via /train-now.",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "student_id",
              "value": "{{student_id}}",
              "type": "text",
              "description": "Student ID (e.g. 6600001)"
            },
            {
              "key": "name",
              "value": "John Doe",
              "type": "text",
              "description": "Student Name (e.g. John Doe)"
            },
            {
              "key": "files",
              "type": "file",
              "src": [],
              "description": "1-3 clear front-facing photos (select multiple files)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        }
      },
      "response": [
        {
          "name": "Queued",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"message\": \"Images queued for processing successfully\",\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\"\n}"
        }
      ]
    },
    {
      "name": "Check Registration Status",
      "description": "Check whether the face registration for a student has been processed.\n\nChecks local .pkl file for existing embeddings (works in both Supabase and SQLite mode).",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/register/status/{{student_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["register", "status", "{{student_id}}"]
        }
      },
      "response": [
        {
          "name": "Completed",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"completed\",\n    \"message\": \"Face extracted and saved successfully\"\n}"
        },
        {
          "name": "Pending",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\",\n    \"message\": \"Waiting for AI processing (trigger /train-now)\"\n}"
        }
      ]
    },
    {
      "name": "Trigger Training (Process Queue)",
      "description": "Manually trigger AI processing for all pending queue items. Extracts face embeddings and updates the .pkl file.\n\nWorks with both Supabase (queue in PostgreSQL) and SQLite (local queue).",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": []
        },
        "url": {
          "raw": "{{baseUrl}}/train-now",
          "host": ["{{baseUrl}}"],
          "path": ["train-now"]
        }
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"message\": \"Training completed\",\n    \"processed_students\": [\"6600001\"],\n    \"total_pending\": 3\n}"
        }
      ]
    },
    {
      "name": "Verify Face (File Upload)",
      "description": "Real-time face verification. Matches the input photo against local .pkl embeddings (fast, no network) and logs the attendance record to Supabase/SQLite.",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Photo of the person to identify"
            },
            {
              "key": "device_id",
              "value": "ESP32-S3-01",
              "type": "text",
              "description": "Device identifier (optional, default: ESP32-S3-01)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["verify"]
        }
      },
      "response": [
        {
          "name": "Match Found",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.85,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        },
        {
          "name": "Unknown Person",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": false,\n    \"student_id\": null,\n    \"similarity_score\": 0.0,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        }
      ]
    },
    {
      "name": "Verify Face (Base64)",
      "description": "Alternative method to verify using a base64-encoded image string. Useful for ESP32, mobile apps, and web interfaces.\n\nHow to convert image to base64:\n- macOS/Linux: base64 -i photo.jpg\n- Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes(\"photo.jpg\"))",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image_base64",
              "value": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQ...",
              "type": "text",
              "description": "Base64-encoded image with data URI prefix"
            },
            {
              "key": "device_id",
              "value": "ESP32-S3-01",
              "type": "text",
              "description": "Device identifier (optional, default: ESP32-S3-01)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["verify"]
        }
      },
      "response": [
        {
          "name": "Match Found",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.85,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        },
        {
          "name": "Unknown Person",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": false,\n    \"student_id\": null,\n    \"similarity_score\": 0.0,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        }
      ]
    },
    {
      "name": "Get Attendance Logs",
      "description": "Retrieve the history of all face verification check-ins from Supabase or SQLite.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/logs?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["logs"],
          "query": [
            {
              "key": "limit",
              "value": "50",
              "description": "Number of log entries to return (default: 50)"
            }
          ]
        }
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "[\n    {\n        \"id\": 1,\n        \"student_id\": \"6600001\",\n        \"similarity_score\": 0.85,\n        \"device_id\": \"ESP32-S3-01\",\n        \"timestamp\": \"2026-06-24T12:30:00\"\n    }\n]"
        }
      ]
    },
    {
      "name": "Legacy Endpoints (Backward Compatible)",
      "description": "These endpoints from the original system are still available for backward compatibility. They now work through the same database abstraction layer (Supabase or SQLite).",
      "item": [
        {
          "name": "Create User (Legacy)",
          "description": "Creates a new user profile only. Use /register instead.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"6600001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "List All Users (Legacy)",
          "description": "Lists all registered users from the .pkl embeddings file.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Upload Face Image (Legacy)",
          "description": "Upload a face image for an existing user. Use /register instead.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Clear face photo (JPG/PNG)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/1/images",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1", "images"],
              "variable": [
                {
                  "key": "user_id",
                  "value": "1",
                  "description": "User ID (compatibility mode)"
                }
              ]
            }
          }
        },
        {
          "name": "Train Model (Legacy)",
          "description": "Full retrain/reindex from existing .pkl embeddings. Use /train-now for queue-based processing.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "{{baseUrl}}/train",
              "host": ["{{baseUrl}}"],
              "path": ["train"]
            }
          }
        }
      ]
    }
  ]
}
