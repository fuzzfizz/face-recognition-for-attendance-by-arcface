{
  "info": {
    "name": "Face Recognition API (Async Queue)",
    "description": "Asynchronous API with queue-based registration — non-blocking /register, background AI processing\n\n## What's New\n- **Async registration:** `/register` saves images + queues, returns instantly\n- **Status tracking:** `/register/status/{id}` to check AI processing progress\n- **Manual trigger:** `/train-now` to process all pending queue items\n- **student_id based:** All responses use `student_id` instead of `user_id` + `name`\n- **Backward compatible:** Legacy endpoints still work",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "face-recognition-api"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://<YOUR-VM-IP>:8000",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "6600001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "description": "Check if the server is running",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Register (Async Queue)",
      "description": "Upload face images for registration. Non-blocking — saves images to disk, creates queue entries (status='pending'), and returns immediately.\n\n**AI processing happens later** via `/train-now` or a scheduled worker.\n\n**Recommended:** 1-3 clear front-facing photos per person.",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "student_id",
              "value": "{{student_id}}",
              "type": "text",
              "description": "Student ID (e.g. 6600001)"
            },
            {
              "key": "files",
              "type": "file",
              "src": [],
              "description": "1-3 clear front-facing photos (select multiple files)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        }
      },
      "response": [
        {
          "name": "Queued",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"message\": \"Images queued for processing successfully\",\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\"\n}"
        }
      ]
    },
    {
      "name": "Check Registration Status",
      "description": "Check whether the AI has finished processing face embeddings for a student.\n\nReturns one of: pending | completed | failed",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/register/status/{{student_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["register", "status", "{{student_id}}"]
        }
      },
      "response": [
        {
          "name": "Pending",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\",\n    \"message\": \"Waiting for AI processing\"\n}"
        },
        {
          "name": "Completed",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"completed\",\n    \"message\": \"Face extracted and saved successfully\"\n}"
        },
        {
          "name": "Failed",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"failed\",\n    \"message\": \"No face detected, please upload a new clear image\"\n}"
        }
      ]
    },
    {
      "name": "Trigger Training (Process Queue)",
      "description": "Manually trigger AI processing for all pending queue items. Extracts face embeddings and updates the .pkl file.\n\n**For production:** Set up a cron job to call this every few minutes.",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": []
        },
        "url": {
          "raw": "{{baseUrl}}/train-now",
          "host": ["{{baseUrl}}"],
          "path": ["train-now"]
        }
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"message\": \"Background training started\",\n    \"pending_images_in_queue\": 15\n}"
        }
      ]
    },
    {
      "name": "Verify Face (File Upload)",
      "description": "Real-time face verification. Matches the input photo against trained embeddings and logs the attendance record.",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Photo of the person to identify"
            },
            {
              "key": "device_id",
              "value": "ESP32-S3-01",
              "type": "text",
              "description": "Device identifier (optional, default: ESP32-S3-01)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["verify"]
        }
      },
      "response": [
        {
          "name": "Match Found",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.85,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        },
        {
          "name": "Unknown Person",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": false,\n    \"student_id\": null,\n    \"similarity_score\": 0.0,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        }
      ]
    },
    {
      "name": "Verify Face (Base64)",
      "description": "Alternative method to verify using a base64-encoded image string. Useful for mobile apps and web interfaces.\n\n**How to convert image to base64:**\n- macOS/Linux: `base64 -i photo.jpg`\n- Windows PowerShell: `[Convert]::ToBase64String([IO.File]::ReadAllBytes(\"photo.jpg\"))`",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image_base64",
              "value": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQ...",
              "type": "text",
              "description": "Base64-encoded image with data URI prefix"
            },
            {
              "key": "device_id",
              "value": "ESP32-S3-01",
              "type": "text",
              "description": "Device identifier (optional, default: ESP32-S3-01)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["verify"]
        }
      },
      "response": [
        {
          "name": "Match Found",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.85,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        },
        {
          "name": "Unknown Person",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "{\n    \"match\": false,\n    \"student_id\": null,\n    \"similarity_score\": 0.0,\n    \"timestamp\": \"2026-06-24T12:30:00\"\n}"
        }
      ]
    },
    {
      "name": "Get Attendance Logs",
      "description": "Retrieve the history of all face verification check-ins.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/logs?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["logs"],
          "query": [
            {
              "key": "limit",
              "value": "50",
              "description": "Number of log entries to return (default: 50)"
            }
          ]
        }
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "header": [],
          "body": "[\n    {\n        \"id\": 1,\n        \"student_id\": \"6600001\",\n        \"similarity_score\": 0.85,\n        \"device_id\": \"ESP32-S3-01\",\n        \"timestamp\": \"2026-06-24T12:30:00\"\n    }\n]"
        }
      ]
    },
    {
      "name": "Legacy Endpoints",
      "description": "These endpoints from the original system are still available for backward compatibility.",
      "item": [
        {
          "name": "Create User (Legacy)",
          "description": "Creates a new user profile only. Use `/register` instead.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"6600001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "List All Users (Legacy)",
          "description": "Lists all registered users in the database.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Upload Face Image (Legacy)",
          "description": "Upload a face image for an existing user. Use `/register` instead.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Clear face photo (JPG/PNG)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/1/images",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1", "images"],
              "variable": [
                {
                  "key": "user_id",
                  "value": "1",
                  "description": "ID of the user (from Create User response)"
                }
              ]
            }
          }
        },
        {
          "name": "Train Model (Legacy)",
          "description": "Full retrain from all user images in DB. Use `/train-now` for queue-based processing.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "{{baseUrl}}/train",
              "host": ["{{baseUrl}}"],
              "path": ["train"]
            }
          }
        }
      ]
    }
  ]
}
