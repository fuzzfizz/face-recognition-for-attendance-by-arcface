# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=face-images

# Admin Configuration
ADMIN_API_KEY=your-secret-admin-key

# Face Recognition Configuration
SIMILARITY_THRESHOLD=0.45
MODEL_NAME=buffalo_l

# Server Configuration
HOST=0.0.0.0
PORT=8000
TRAINING_SCHEDULE_INFO="daily at 12:00, 17:00"
TRAINING_SCHEDULE_TIMES="12:00, 17:00"

# Database Mode Configuration
# Defaults to "sqlite" if not set. Supports "mysql", "supabase", and "sqlite".
DB_MODE=sqlite

# MySQL Database URL (used if DB_MODE=mysql)
# MYSQL_URL=mysql+pymysql://user:password@host:port/database

# Fallback (SQLite, used when DB_MODE is sqlite or Supabase vars are not set)
DATABASE_URL=sqlite:///./data/face_recognition.db
