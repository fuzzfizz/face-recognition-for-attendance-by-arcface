{
  "info": {
    "name": "Face Recognition Kiosk API v5 (FastAPI + Async Queue)",
    "description": "Comprehensive Postman collection for the restructured Face Recognition Kiosk API v5.0.0. Supports async photo registration, server-side fail-fast face validation, dynamic status polling, background training scheduling, and secure admin key validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "face-recognition-api-v5"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://34.124.240.7:8000",
      "type": "string"
    },
    {
      "key": "adminKey",
      "value": "my-secure-admin-token-12345",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Verifies that the API server is online and returns the current storage/database mode (`supabase` or `sqlite`)."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"status\": \"ok\",\n    \"mode\": \"sqlite\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Face Registration",
      "item": [
        {
          "name": "Register Student (Async Queue)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "student_id",
                  "value": "{{student_id}}",
                  "type": "text",
                  "description": "Unique identifier for the student."
                },
                {
                  "key": "name",
                  "value": "John Doe",
                  "type": "text",
                  "description": "Full name of the student."
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "10 clear front-facing face images (select multiple)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Upload face images for registration. Performs a quick, fail-fast server-side face detection check. If any image contains no faces, aborts immediately with a 400 Bad Request. Otherwise, queues the registration for offline model training."
          },
          "response": [
            {
              "name": "Queued Successfully",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"message\": \"Images queued for processing successfully\",\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\"\n}"
            },
            {
              "name": "No Face Detected",
              "status": "Bad Request",
              "code": 400,
              "header": [],
              "body": "{\n    \"detail\": \"No face detected in photo (face_close.jpg). Please align your face in the camera.\"\n}"
            }
          ]
        },
        {
          "name": "Check Registration Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/register/status/{{student_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["register", "status", "{{student_id}}"]
            },
            "description": "Queries the registration queue status for a specific Student ID. Returns current status (`pending`, `completed`, or `failed` with error reason)."
          },
          "response": [
            {
              "name": "Pending",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"pending\",\n    \"message\": \"Waiting for AI processing. Scheduled updates run daily at 19:00.\"\n}"
            },
            {
              "name": "Completed",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"student_id\": \"6600001\",\n    \"status\": \"completed\",\n    \"message\": \"Face extracted and saved successfully\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Model Administration",
      "item": [
        {
          "name": "Force Training Now (Trigger Processing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/train-now",
              "host": ["{{baseUrl}}"],
              "path": ["train-now"]
            },
            "description": "Trigger processing of all pending queue items immediately, extracting face embeddings and regenerating the ArcFace model. Requires validation with the `X-Admin-Key` header."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"message\": \"Training completed\",\n    \"processed_students\": [\n        \"6600001\"\n    ],\n    \"total_pending\": 1\n}"
            },
            {
              "name": "Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [],
              "body": "{\n    \"detail\": \"Unauthorized\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Verification & Attendance",
      "item": [
        {
          "name": "Verify Face (File Upload)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Close-up front photo of the student to identify."
                },
                {
                  "key": "device_id",
                  "value": "ESP32-S3-01",
                  "type": "text",
                  "description": "Identifier of the camera terminal (optional)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["verify"]
            },
            "description": "Real-time face verification endpoint for photo uploads. Matches image against local ArcFace model cache and logs attendance to the database."
          },
          "response": [
            {
              "name": "Match Found",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.82,\n    \"timestamp\": \"2026-07-01T12:00:00\"\n}"
            },
            {
              "name": "No Match Found",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"match\": false,\n    \"student_id\": null,\n    \"similarity_score\": 0.45,\n    \"timestamp\": \"2026-07-01T12:00:00\"\n}"
            }
          ]
        },
        {
          "name": "Verify Face (Base64)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"image_base64\": \"/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAAMCAgMCAgMDAwMEAwMEBQ...\",\n    \"device_id\": \"ESP32-S3-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["verify"]
            },
            "description": "Verify student identification via Base64-encoded image string payload. Ideal for low-memory microcontrollers like the ESP32."
          },
          "response": [
            {
              "name": "Match Found",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n    \"match\": true,\n    \"student_id\": \"6600001\",\n    \"similarity_score\": 0.82,\n    \"timestamp\": \"2026-07-01T12:00:00\"\n}"
            }
          ]
        },
        {
          "name": "Get Attendance Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Retrieves the check-in history logs from the active SQLite database or Supabase."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "[\n    {\n        \"id\": 1,\n        \"student_id\": \"6600001\",\n        \"similarity_score\": 0.82,\n        \"device_id\": \"ESP32-S3-01\",\n        \"timestamp\": \"2026-07-01T12:00:00\"\n    }\n]"
            }
          ]
        }
      ]
    }
  ]
}
